# Python environments and caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.egg-info/
build/
dist/

# Local configuration, secrets, credentials, and private keys
.env
.env.*
credentials*
*credentials*
*.pem
*.key
*.secret
*.token
secrets/

# Logs and operating-system metadata
*.log
*.out
.DS_Store
Thumbs.db

# Notebook-generated temporary files and checkpoints
.ipynb_checkpoints/
*.ipynb_checkpoints

# Local datasets and derived transaction files
data/raw/*
data/processed/*

# Unnecessary notebook outputs and local exports
notebooks/.cache/
notebooks/exports/

# Model artifacts are private/generated by default.
models/*
*.joblib
*.pkl
*.pickle
*.onnx

# Approved deployment model artifact only
!models/random_forest.joblib

# Generated figures are private/generated by default.
reports/figures/*

# Approved deployment SHAP figures only
!reports/figures/random_forest_shap_feature_importance.png
!reports/figures/random_forest_shap_beeswarm.png
!reports/figures/random_forest_shap_waterfall.png

# Historical metrics are intentionally publishable.
!reports/final_model_metrics.json
